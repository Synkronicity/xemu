{
  "name": "Xemu Surround Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "mesonbuild.mesonbuild",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "files.associations": {
          "*.c": "c",
          "*.h": "c"
        },
        "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild"
      }
    }
  },
  "postCreateCommand": "git submodule update --init --recursive && sudo apt-get update && sudo apt-get install -y build-essential meson ninja-build ccache libfuse2 libusb-1.0-0-dev curl git libgl1-mesa-dev libglu1-mesa-dev",
  "remoteUser": "vscode"
}